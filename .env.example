# Fake values — replace with real ones in your local .env (never committed).
#
# OpenAI project API key for the GPT-Live API. Stays on the trusted server.
OPENAI_API_KEY=replace-with-your-real-key

# Live voice model
OPENAI_LIVE_MODEL=gpt-live-1

# Primary WebSocket endpoint for Live sessions
OPENAI_LIVE_WS_URL=wss://api.openai.com/v1/live/sessions

# Voice and audio format (see skills/gpt-live/SKILL.md, "Audio format rules")
LIVE_VOICE=marin
LIVE_AUDIO_RATE=24000